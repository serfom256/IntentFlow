order.findById = {
    SELECT * FROM orders WHERE id = [id]
}

order.findAll = {
    SELECT * FROM orders ORDER BY id
}

order.findPage = {
    SELECT * FROM orders ORDER BY id LIMIT [limit] OFFSET [offset]
}

order.count = {
    SELECT count(*) FROM orders
}

order.exists = {
    SELECT count(*) FROM orders WHERE id = [id]
}

order.insert = {
    INSERT INTO orders (customer_id, status, total, items_count, created_at) VALUES ([customer_id], [status], [total], [items_count], [created_at])
}

order.update = {
    UPDATE orders SET customer_id = [customer_id], status = [status], total = [total], items_count = [items_count] WHERE id = [id]
}

order.delete = {
    DELETE FROM orders WHERE id = [id]
}
